#!/bin/sh
set -eu

message_file=${1:?commit message file is required}
subject=$(sed -n '1p' "$message_file")

# Git-generated merge commits do not use the Conventional Commits header.
case "$subject" in
  Merge\ *) exit 0 ;;
esac

if printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9._/-]*\))?(!)?: .+'; then
  exit 0
fi

cat >&2 <<'MESSAGE'
Commit convention non respectée.
Format attendu : <type>(<scope>): <description>
Le scope est facultatif; le type peut être feat, fix, docs, style,
refactor, perf, test, build, ci, chore ou revert.
Exemple : feat(core): add round timeout
MESSAGE
printf 'Message reçu : %s\n' "$subject" >&2
exit 1
